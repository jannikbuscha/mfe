{
  "name": "mf2",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "mf2",
  "sourceRoot": "apps/mf2/src",
  "tags": ["scope:mf2", "type:app"],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "outputs": ["{workspaceRoot}/dist/apps/mf2"],
      "cache": true,
      "inputs": ["production", "^production"],
      "defaultConfiguration": "production",
      "options": {
        "cacheExternalArtifacts": true,
        "tsConfig": "apps/mf2/tsconfig.federation.json"
      },
      "configurations": {
        "production": {
          "target": "mf2:esbuild:production"
        },
        "development": {
          "target": "mf2:esbuild:development",
          "dev": true
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "mf2:serve-original:development",
        "tsConfig": "apps/mf2/tsconfig.federation.json",
        "rebuildDelay": 500,
        "cacheExternalArtifacts": true,
        "dev": true,
        "devServer": true,
        "port": 0
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/mf2",
        "browser": "apps/mf2/src/main.ts",
        "tsConfig": "apps/mf2/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/mf2/public"
          }
        ],
        "styles": ["apps/mf2/src/styles.scss"],
        "polyfills": ["es-module-shims"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve-original": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "options": {
        "port": 4202
      },
      "configurations": {
        "production": {
          "buildTarget": "mf2:esbuild:production"
        },
        "development": {
          "buildTarget": "mf2:esbuild:development"
        }
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false,
        "buildTarget": "mf2:esbuild"
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "mf2:build",
        "port": 4202,
        "staticFilePath": "dist/apps/mf2/browser",
        "spa": true
      }
    }
  }
}
